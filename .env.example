# ---------------------------------------------------------------------------
# job-agent environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be committed. In GitHub Actions these are provided as repository
# secrets instead of a file.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# Supported: gemini | none
# `none` disables all LLM calls; the pipeline then uses deterministic logic
# only and marks genuinely ambiguous cases as UNKNOWN.
LLM_PROVIDER=gemini

# Google AI Studio API key for the Gemini API (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional overrides for the Gemini provider.
# GEMINI_MODEL=gemini-2.5-flash
# LLM_MAX_CALLS_PER_RUN=300

# --- Email notifications (optional) ---------------------------------------
# If any of these are missing the pipeline logs a warning and continues.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
# Defaults to SMTP_USERNAME when unset.
# NOTIFICATION_FROM=

# --- Runtime overrides (optional) -----------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text          # text | json
# FRESHNESS_HOURS=24
# MAX_CONCURRENCY=8
# JOB_AGENT_CONFIG_DIR=config
